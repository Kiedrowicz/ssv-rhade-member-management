# Datenbank – diese App hat KEINEN eigenen MariaDB-Container, sondern nutzt
# den von travel-expenses (siehe CLAUDE.md, Abschnitt "Kein eigener
# MariaDB-Container").
#
# Lokale Entwicklung (ausserhalb Docker, travel-expenses' MariaDB laeuft
# bereits via "docker-compose up mariadb" dort):
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=ssv_members
DB_PASSWORD=change-me
DB_NAME=ssv_member_management
SHARED_DB_NAME=ssv_shared_members

# Vor dem ersten Start einmalig scripts/grant-db-user.sql gegen die
# laufende MariaDB ausfuehren (legt den User ssv_members + die Datenbank
# ssv_member_management an) - Passwort dort auf denselben Wert wie oben
# setzen.

# Session-Token (JWT) fuer den Login. Zufaelligen, langen Wert erzeugen,
# z.B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
